{
    "redirects": [
        {
            "source": "/blog",
            "destination": "/guides",
            "permanent": true
        },
        {
            "source": "/blog/:path*",
            "destination": "/guides/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
